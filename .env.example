# Copy this file to .env and fill in your own values.
# .env holds the real password and is gitignored; this template is committed
# so anyone cloning the repo knows which variables the scripts expect.

# Host of the PostgreSQL server.
#   "auto"      - resolve the Windows host IP from WSL (database on Windows)
#   "localhost" - database on the same machine as the code
DB_HOST=auto
DB_PORT=5433
DB_NAME=telco_churn
DB_USER=postgres
DB_PASSWORD=
